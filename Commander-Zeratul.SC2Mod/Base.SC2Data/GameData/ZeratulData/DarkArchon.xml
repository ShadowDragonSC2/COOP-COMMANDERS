            <ModifyFlags index="SuppressMoving" value="1"/>
            <ModifyFlags index="SuppressTurning" value="1"/>
        </Modification>
        <Duration value="12"/>
        <Alignment value="Negative"/>
    </CBehaviorBuff>

    <CValidatorLocationEnumArea id="ZeratulCommanderMaelstrom@Search">
        <AreaArray Compare="GE" Count="2" Radius="10"/>
