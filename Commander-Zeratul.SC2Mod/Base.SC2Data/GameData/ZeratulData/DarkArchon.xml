    <CBehaviorBuff id="ZeratulCommanderMaelstrom">
        <Modification>
            <ModifyFlags index="DisableAbils" value="1"/>
            <ModifyFlags index="Reveal" value="1"/>
            <ModifyFlags index="SuppressMoving" value="1"/>
            <ModifyFlags index="SupressTurning" value="1"/>
        </Modification>
        <Duration value="12"/>
        <Alignment value="Negative"/>
    </CBehaviorBuff>
    <CEffectApplyBehavior id="ZeratulCommanderMaelstrom@AB"/>
