//--------------------------------------------------------------------------------------------------
bool lib3A96CF55_gt_CommanderEnable_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster == null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCreate(1, "Pylon", 0, libBEDD5153_gf_TriggeringPlayerCC(), RegionGetCenter(RegionPlayableMap()), 270.0);
    lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster = UnitLastCreated();
    return true;
}

