// Functions
point lib3A96CF55_gf_CalculatePointFromArtifact (int lp_player) {
    // Variable Declarations
    point lv__point;
    int lv_attempts;

    // Automatic Variable Declarations
    // Variable Initialization
    lv__point = RegionRandomPoint(RegionPlayableMap());

    // Implementation
    while ((lv_attempts < 20) && (PathingType(lv__point) != c_pathingGround) && (PointPathingIsConnected(lv__point, PlayerStartLocation(lp_player)) == false)) {
        lv__point = RegionRandomPoint(RegionPlayableMap());
        lv_attempts += 1;
        Wait(0.0625, c_timeReal);
    }
    return lv__point;
}

string lib3A96CF55_gf_PreviousUnitEvolve (unit lp_unit) {
    // Variable Declarations
    string lv_raceUnit;
    int lv_priorityoriginunit;
    string lv_category;
    int lv_prioritycurrentunit;
    int lv_priorityoldunit;
    string lv_unitentry;
    string lv_result;
    bool lv_firstlow;

    // Automatic Variable Declarations
    int autoB7983870_catalog;
    int autoB7983870_i;

    // Variable Initialization
    lv_raceUnit = lib6CA20615_gf_RaceOfUnit(lp_unit);
    lv_priorityoriginunit = CatalogFieldValueGetAsInt(c_gameCatalogUnit, UnitGetType(lp_unit), "GlossaryPriority", c_playerAny);
    lv_category = CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lp_unit), "GlossaryCategory", c_playerAny);
    lv_prioritycurrentunit = lv_priorityoriginunit;

    // Implementation
    autoB7983870_catalog = c_gameCatalogUnit;
    autoB7983870_i = 1;
    for ( ; autoB7983870_i <= CatalogEntryCount(c_gameCatalogUnit) ; autoB7983870_i += 1 ) {
        lv_unitentry = CatalogEntryGet(autoB7983870_catalog, autoB7983870_i);
        if (((lv_raceUnit != lib6CA20615_gf_RaceOfUnitType(lv_unitentry)) || (lv_category != CatalogFieldValueGet(c_gameCatalogUnit, lv_unitentry, "GlossaryCategory", c_playerAny)) || (UnitTypeGetProperty(lv_unitentry, c_unitPropSuppliesUsed) == 0.0) || (UnitTypeGetProperty(lv_unitentry, c_unitPropSuppliesUsed) == 0.0))) {
            continue;
        }

        lv_prioritycurrentunit = CatalogFieldValueGetAsInt(c_gameCatalogUnit, lv_unitentry, "GlossaryPriority", c_playerAny);
        if ((lv_priorityoldunit < lv_prioritycurrentunit) && (lv_prioritycurrentunit < lv_priorityoriginunit)) {
            lv_priorityoldunit = lv_prioritycurrentunit;
            lv_result = lv_unitentry;
            TextExpressionSetToken("Param/Expression/lib_3A96CF55_EE8FE678", "A", IntToText(lv_priorityoldunit));
            TextExpressionSetToken("Param/Expression/lib_3A96CF55_EE8FE678", "B", IntToText(lv_prioritycurrentunit));
            TextExpressionSetToken("Param/Expression/lib_3A96CF55_EE8FE678", "C", IntToText(lv_priorityoriginunit));
            TriggerDebugOutput(1, TextExpressionAssemble("Param/Expression/lib_3A96CF55_EE8FE678"), true);
        }

    }
    return lv_result;
}

// Triggers
//--------------------------------------------------------------------------------------------------
// Trigger: Playing Attack Sounds Using Attack Towards
//--------------------------------------------------------------------------------------------------
bool lib3A96CF55_gt_PlayingAttackSoundsUsingAttackTowards_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_unit = UnitGroupUnit(UnitSubgroupSelected(EventPlayer()), 1);

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventTargetModeState() == c_targetModeStateOn)) {
        CatalogFieldValueSet(c_gameCatalogActor, UnitGetType(lv_unit), "SoundArray[" + IntToString(4) + "]", EventPlayer(), "");
    }
    else {
        CatalogFieldValueSet(c_gameCatalogActor, UnitGetType(lv_unit), "SoundArray[" + IntToString(4) + "]", EventPlayer(), CatalogFieldValueGet(c_gameCatalogActor, UnitGetType(lv_unit), "SoundArray[" + IntToString(4) + "]", c_playerAny));
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib3A96CF55_gt_PlayingAttackSoundsUsingAttackTowards_Init () {
    lib3A96CF55_gt_PlayingAttackSoundsUsingAttackTowards = TriggerCreate("lib3A96CF55_gt_PlayingAttackSoundsUsingAttackTowards_Func");
    TriggerAddEventTargetModeUpdate(lib3A96CF55_gt_PlayingAttackSoundsUsingAttackTowards, c_playerAny, AbilityCommand("attack", 0), c_targetModeStateAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Commander - Enable
//--------------------------------------------------------------------------------------------------
bool lib3A96CF55_gt_CommanderEnable_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster == null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCreate(1, "Pylon", 0, libBEDD5153_gf_TriggeringPlayerCC(), RegionGetCenter(RegionPlayableMap()), 270.0);
    lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster = UnitLastCreated();
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib3A96CF55_gt_CommanderEnable_Init () {
    lib3A96CF55_gt_CommanderEnable = TriggerCreate("lib3A96CF55_gt_CommanderEnable_Func");
    libBEDD5153_gf_PlayerRaceChangesCC(lib3A96CF55_gt_CommanderEnable, c_playerAny, "COOPZeratul", "On");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Commander - Disable
//--------------------------------------------------------------------------------------------------
bool lib3A96CF55_gt_CommanderDisable_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TextExpressionSetToken("Param/Expression/lib_3A96CF55_9EE957D9", "A", StringToText((libBEDD5153_gf_ChangingRaceCC())));
    TextExpressionSetToken("Param/Expression/lib_3A96CF55_9EE957D9", "B", StringToText((libBEDD5153_gf_ChangedRaceCC())));
    TriggerDebugOutput(1, TextExpressionAssemble("Param/Expression/lib_3A96CF55_9EE957D9"), true);
    if ((lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_artifact != null)) {
        UnitRemove(lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_artifact);
        lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_artifact = null;
    }

    if ((lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster != null)) {
        UnitRemove(lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster);
        lib3A96CF55_gv_player[libBEDD5153_gf_TriggeringPlayerCC()].lv_topbar_caster = null;
    }

    return true;
}

