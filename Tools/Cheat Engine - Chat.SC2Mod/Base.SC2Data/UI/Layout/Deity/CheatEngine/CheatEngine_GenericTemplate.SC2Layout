<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Constant name="scrollwidth" val="20"/>
    <Constant name="scrollwidthnegative" val="-20"/>

    <!-- BG -->

    <Frame type="Image" name="BGNoAnchorTemplate">
        <Texture val="@CheatEngine/UI/Container"/>
        <TextureType val="HorizontalBorder"/>
    </Frame>
    <Frame type="Image" name="BGTemplate" template="CheatEngine_GenericTemplate/BGNoAnchorTemplate">
        <Anchor relative="$parent"/>
    </Frame>

    <!-- Frames -->

    <Frame type="Frame" name="CheckerListPlayer">
        <Frame type="Button" name="player0" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Text val="{$PlayerName0/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player1" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName1/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player2" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName2/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player3" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName3/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player4" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName4/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player5" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName5/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player6" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName6/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player7" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName7/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player8" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName8/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player9" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName9/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player10" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName10/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player11" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName11/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player12" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName12/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player13" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName13/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player14" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName14/@StringValue}"/>
        </Frame>
        <Frame type="Button" name="player15" template="CheatEngine_TemplatesButtons/CheckedButtonTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/player0" pos="Min" offset="0"/>
            <Text val="{$PlayerName15/@StringValue}"/>
        </Frame>
    </Frame>

    <!-- Scrollable Frame -->

    <Frame type="ScrollableFrame" name="ScrollVerticalTemplate">
        <AcceptsMouse val="True"/>
 
        <Frame type="ScrollBar" name="ScrollBar">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Orientation val="Vertical"/>
            <StepValue val="50"/>
            <Width val="#scrollwidth"/>
 
            <Frame type="Image" name="Image">
                <Anchor relative="$parent"/>
                <Texture val="@@UI/StandardScrollBar"/>
                <TextureType val="NineSlice"/>
                <Tiled val="true"/>
            </Frame>
 
            <Frame type="Button" name="Button">
                <Frame type="Image" name="NormalImage">
                    <Anchor relative="$parent"/>
                    <Texture val="@@UI/StandardScrollBarButton"/>
                    <TextureType val="NineSlice"/>
                    <StateCount val="2"/>
                    <Tiled val="true"/>
                </Frame>
 
                <Frame type="Image" name="HoverImage">
                    <Anchor relative="$parent"/>
                    <Texture val="@@UI/StandardScrollBarButtonHover"/>
                    <TextureType val="NineSlice"/>
                    <StateCount val="2"/>
                    <Tiled val="true"/>
                </Frame>
            </Frame>
        </Frame>

        <Frame type="Image" name="BG" template="CheatEngine_GenericTemplate/BGTemplate"/>
 
        <Frame type="Frame" name="ContainerFrame">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="#scrollwidthnegative"/>
        </Frame>
    </Frame>

    <Frame type="ScrollableFrame" name="ScrollHorizontalTemplate">
        <AcceptsMouse val="True"/>

        <Frame type="ScrollBar" name="ScrollBar">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Orientation val="Horizontal"/>
            <StepValue val="60"/>
            <Height val="#scrollwidth"/>
            <Continuous val="False"/>
 
            <Frame type="Image" name="Image">
                <Anchor relative="$parent"/>
                <Texture val="@@UI/StandardScrollBar"/>
                <TextureType val="NineSlice"/>
                <Tiled val="true"/>
            </Frame>
 
            <Frame type="Button" name="Button">
                <Frame type="Image" name="NormalImage">
                    <Anchor relative="$parent"/>
                    <Texture val="@@UI/StandardScrollBarButton"/>
                    <TextureType val="NineSlice"/>
                    <StateCount val="2"/>
                    <Tiled val="true"/>
                </Frame>
 
                <Frame type="Image" name="HoverImage">
                    <Anchor relative="$parent"/>
                    <Texture val="@@UI/StandardScrollBarButtonHover"/>
                    <TextureType val="NineSlice"/>
                    <StateCount val="2"/>
                    <Tiled val="true"/>
                </Frame>
            </Frame>
        </Frame>

        <Frame type="Image" name="BG" template="CheatEngine_GenericTemplate/BGNoAnchorTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent/ScrollBar" pos="Min" offset="0"/>
        </Frame>
 
        <Frame type="Frame" name="ContainerFrame">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="#scrollwidthnegative"/>
            <Width val="60"/>
        </Frame>

    </Frame>

    
</Desc>