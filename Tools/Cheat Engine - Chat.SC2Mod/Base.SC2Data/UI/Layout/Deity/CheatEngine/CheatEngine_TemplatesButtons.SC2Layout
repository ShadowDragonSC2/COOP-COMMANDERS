<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="Button" name="GenericSmallButton">
        <Width val="45"/>
        <Height val="45"/>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/GenericSmallButton"/>
            <StateCount val="2"/>
            <TextureType val="EndCap"/>
        </Frame>
        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/GenericSmallButtonOver"/>
            <StateCount val="2"/>
            <TextureType val="EndCap"/>
        </Frame>
        <Frame type="Image" name="Icon">
            <Anchor relative="$parent"/>
            <Texture val="Assets\Textures\btn-lostvinking-bomb.dds"/>
            <TextureType val="Normal"/>
        </Frame>

        <StateGroup name="StateGroup1">
            <DefaultState val="Default"/>
        
            <State name="Disable">
                <When type="Property" frame="$this/Icon" Texture="" operator="Equal"/>
                <Action type="SetProperty" frame="$this" Enabled="False"/>
                <Action type="SetProperty" frame="$this/Icon" Visible="False"/>
            </State>
        
            <State name="Default">
                <Action type="SetProperty" frame="$this" Enabled="True"/>
                <Action type="SetProperty" frame="$this/Icon" Visible="True"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="Button" name="GenericSmallButton2">
        <Width val="50"/>
        <Height val="50"/>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/GenericSmallButton2"/>
            <StateCount val="2"/>
            <TextureType val="Border"/>
        </Frame>
        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/GenericSmallButtonOver2"/>
            <StateCount val="2"/>
            <TextureType val="Border"/>
        </Frame>
    </Frame>

    <Frame type="Button" name="PlayerRaceSelect" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
        <Width val="60"/>
        <Height val="60"/>

        <Frame type="Image" name="RaceIcon">
            <Anchor relative="$parent" offset="-10"/>
            <TextureType val="Normal"/>
        </Frame>
    </Frame>

    <Frame type="Button" name="EditorCategoryButtonMediumTemplate">
        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
        <Width val="70"/>
        <Height val="70"/>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/EditorCategoryMediumButton"/>
            <ColorAdjustMode val="Colorize"/>
            <AdjustmentColor val="#ChatDividerColor_Terr"/>
        </Frame>
        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>
            <Texture val="@CheatEngine/UI/EditorCategoryMediumButtonOver"/>
            <ColorAdjustMode val="Colorize"/>
            <AdjustmentColor val="#ChatDividerColor_Terr"/>
        </Frame>
        <Frame type="Image" name="Icon">
            <Anchor relative="$parent" offset="-10"/>
            <TextureType val="Normal"/>
            <AcceptsMouse val="False"/>
        </Frame>

        <StateGroup name="VisibleIcon">
            <State name="Visible">
                <When type="Property" frame="$this/Icon" Texture="" operator="Equal"/>
                <Action type="SetProperty" Visible="False" frame="$this/Icon"/>
            </State>
        
            <State name="NotVisible">
                <When type="Property" frame="$this/Icon" Texture="" operator="NotEqual"/>
                <Action type="SetProperty" Visible="True" frame="$this/Icon"/>
            </State>
        </StateGroup>

        <StateGroup name="VisibleButton">
            <State name="Visible">
                <When type="Property" frame="$this" Tooltip="" operator="Equal"/>
                <Action type="SetProperty" frame="$this" Visible="False" />
            </State>
        
            <State name="NotVisible">
                <When type="Property" frame="$this" Tooltip="" operator="NotEqual"/>
                <Action type="SetProperty" frame="$this" Visible="True" />
            </State>
        </StateGroup>
        
    </Frame>

    <Frame type="Button" name="CheckedButtonTemplate" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Width val="0"/>
        <Height val="50"/>
        <Toggleable val="True"/>
    </Frame>
</Desc>