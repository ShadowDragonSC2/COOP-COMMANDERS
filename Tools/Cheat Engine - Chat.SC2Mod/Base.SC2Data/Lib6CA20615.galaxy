}

string lib6CA20615_gf_IconCatalogEntry (int lp_catalogType, string lp_catalogEntry) {
    // Variable Declarations
    string lv__img;

    // Automatic Variable Declarations
    // Variable Initialization
    lv__img = (CatalogFieldValueGet(c_gameCatalogUpgrade, lp_catalogEntry, "Icon", c_playerAny));

    // Implementation
    if ((lp_catalogType == c_gameCatalogUpgrade)) {
        if (lib6CA20615_gf_EntryHasIcon(c_gameCatalogUpgrade, lp_catalogEntry)) {
            lv__img = (CatalogFieldValueGet(lp_catalogType, lp_catalogEntry, "Icon", c_playerAny));
        }
        else {
            lv__img = ("Assets\\Textures\\btn-missing-kaeo.dds");
        }
    }
    return lv__img;
}

