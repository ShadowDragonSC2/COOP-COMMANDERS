// Triggers
//--------------------------------------------------------------------------------------------------
// Trigger: Init Topbars
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_InitTopbars_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libBEDD5153_gf_SetTopbarForPlayer(1, libBEDD5153_gf_HookupStandardDialogItem(c_triggerControlTypePanel, "UIContainer/FullscreenLowerContainer/TestTopbar"));
    libBEDD5153_gf_LinkTopbarItemwithTopbarPlayer(libBEDD5153_gf_HookupStandardDialogItem(c_triggerControlTypeButton, "UIContainer/FullscreenLowerContainer/TestTopbar/item1"), 1, "Merc1");
    libBEDD5153_gf_LinkTopbarItemwithTopbarPlayer(libBEDD5153_gf_HookupStandardDialogItem(c_triggerControlTypeButton, "UIContainer/FullscreenLowerContainer/TestTopbar/item2"), 1, "Merc2");
    libBEDD5153_gf_LinkTopbarItemwithTopbarPlayer(libBEDD5153_gf_HookupStandardDialogItem(c_triggerControlTypeButton, "UIContainer/FullscreenLowerContainer/TestTopbar/item3"), 1, "Merc3");
    libBEDD5153_gf_LinkTopbarItemwithTopbarPlayer(libBEDD5153_gf_HookupStandardDialogItem(c_triggerControlTypeButton, "UIContainer/FullscreenLowerContainer/TestTopbar/item4"), 1, "Merc4");
    libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Birth", "TychusMerc", 1, 4, 2.0, c_timeReal, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBEDD5153_gt_InitTopbars_Init () {
    libBEDD5153_gt_InitTopbars = TriggerCreate("libBEDD5153_gt_InitTopbars_Func");
    TriggerAddEventMapInit(libBEDD5153_gt_InitTopbars);
}

//--------------------------------------------------------------------------------------------------
// Trigger: debug
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_debug_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int autoEEB0DC57_val;

    // Actions
    if (!runActions) {
        return true;
    }

    autoEEB0DC57_val = EventKeyPressed();
    if (autoEEB0DC57_val == c_keyQ) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc1", "Death");
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc1", "Birth");
        }
    }
    else if (autoEEB0DC57_val == c_keyW) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc2", "Death");
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc2", "Birth");
        }
    }
    else if (autoEEB0DC57_val == c_keyE) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc3", "Death");
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc3", "Birth");
        }
    }
    else if (autoEEB0DC57_val == c_keyA) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc4", "Death");
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItem(1, "Merc4", "Birth");
        }
    }
    else if (autoEEB0DC57_val == c_keyZ) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Death", "Merc", 1, 4, 0.3, c_timeReal, false);
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Birth", "Merc", 1, 4, 0.3, c_timeReal, false);
        }
    }
    else if (autoEEB0DC57_val == c_keyX) {
        if ((EventKeyControl() == true)) {
            libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Death", "Merc", 4, 1, 0.1, c_timeReal, false);
        }
        else {
            libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Birth", "Merc", 1, 4, 0.1, c_timeReal, false);
        }
    }
    else if (autoEEB0DC57_val == c_keyC) {
        libBEDD5153_gf_PlayAnimationonTopbar(1, "Birth");
    }
    else if (autoEEB0DC57_val == c_keyV) {
        libBEDD5153_gf_PlayAnimationonTopbar(1, "Death");
    }
    else {
    }
    return true;
}

