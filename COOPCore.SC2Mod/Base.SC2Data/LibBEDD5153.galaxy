    TriggerAddEventKeyPressed(libBEDD5153_gt_debug, c_playerAny, c_keyNone, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

//--------------------------------------------------------------------------------------------------
// Trigger: ClickItem
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_ClickItem_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv__p;
    int lv__item;
    string lv__name;
    int lv_item;

    // Automatic Variable Declarations
    playergroup auto84472D3A_g;
    int auto8956396E_ae;
    const int auto8956396E_ai = 1;

    // Variable Initialization
    lv__name = "";
    lv_item = c_invalidDialogControlId;

    // Actions
    if (!runActions) {
        return true;
    }

    auto84472D3A_g = PlayerGroupAll();
    lv__p = -1;
    while (true) {
        lv__p = PlayerGroupNextPlayer(auto84472D3A_g, lv__p);
        if (lv__p < 0) { break; }
        auto8956396E_ae = DataTableInstanceValueCount(libBEDD5153_gv_player[lv__p].lv_topbarItems);
        lv__item = 1;
        for ( ; ( (auto8956396E_ai >= 0 && lv__item <= auto8956396E_ae) || (auto8956396E_ai < 0 && lv__item >= auto8956396E_ae) ) ; lv__item += auto8956396E_ai ) {
            lv__name = DataTableInstanceValueName(libBEDD5153_gv_player[lv__p].lv_topbarItems, lv__item);
            if ((DataTableInstanceValueType(libBEDD5153_gv_player[lv__p].lv_topbarItems, lv__name) != c_dataTypeControl)) {
                continue;
            }

            lv_item = DataTableInstanceGetControl(libBEDD5153_gv_player[lv__p].lv_topbarItems, lv__name);
            if ((EventDialogControl() == lv_item) && (EventDialogControl() == libBEDD5153_gf_GetTopbarItem(lv__p, "Hero1"))) {
                DataTableSetString(false, libBEDD5153_gf_ResponseCIT(EventPlayer(), lv__name, libBEDD5153_gv_eVENT_PARAM_BtnItem), lv__name);
                DataTableSetInt(false, libBEDD5153_gf_ResponseCIT(EventPlayer(), lv__name, libBEDD5153_gv_eVENT_PARAM_TrigPlayer), EventPlayer());
                TriggerSendEvent(libBEDD5153_gf_ResponseCIT(EventPlayer(), lv__name, null));
            }

        }
    }
    return true;
}

