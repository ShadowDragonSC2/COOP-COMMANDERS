//--------------------------------------------------------------------------------------------------
// Trigger: Activate targeting
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_Activatetargeting_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((PlayerRace(libBEDD5153_gf_TriggeringPlayerCC()) == "Neut"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libBEDD5153_gf_PlayAnimationonTopbar(libBEDD5153_gf_TriggeringPlayerCC(), "Death");
    libNtve_gf_SwooshCamera(libBEDD5153_gf_TriggeringPlayerCC(), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + libBEDD5153_gv__height), CameraGetTarget(libBEDD5153_gf_TriggeringPlayerCC()), 1.5);
    libBEDD5153_gv__targetingMode = true;
    libBEDD5153_gv_countStrikes = 0;
    TriggerEnable(libBEDD5153_gt_Strike, true);
    libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Death", "Merc", 1, 4, 0.3, c_timeReal, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBEDD5153_gt_Activatetargeting_Init () {
    libBEDD5153_gt_Activatetargeting = TriggerCreate("libBEDD5153_gt_Activatetargeting_Func");
    libBEDD5153_gf_ClickItemTopbar(libBEDD5153_gt_Activatetargeting, 1, "Merc1");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Strike
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_Strike_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    PlayerCreateEffectPoint(EventPlayer(), ("NukeDetonate"), Point(EventMouseClickedPosXWorld(), EventMouseClickedPosYWorld()));
    libBEDD5153_gv_countStrikes += 1;
    if ((libBEDD5153_gv_countStrikes >= libBEDD5153_gv_maxCountStrikes)) {
        TriggerEnable(TriggerGetCurrent(), false);
        TriggerExecute(libBEDD5153_gt_ExitTargetingMode, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libBEDD5153_gt_Strike_Init () {
    libBEDD5153_gt_Strike = TriggerCreate("libBEDD5153_gt_Strike_Func");
    TriggerEnable(libBEDD5153_gt_Strike, false);
    TriggerAddEventMouseClicked(libBEDD5153_gt_Strike, c_playerAny, c_mouseButtonLeft, true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Exit Targeting Mode
//--------------------------------------------------------------------------------------------------
bool libBEDD5153_gt_ExitTargetingMode_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libBEDD5153_gv__targetingMode == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libBEDD5153_gf_PlayAnimationonTopbar(EventPlayer(), "Birth");
    libNtve_gf_SwooshCamera(EventPlayer(), ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + libBEDD5153_gv__height), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), CameraGetTarget(EventPlayer()), 1.5);
    libBEDD5153_gv__targetingMode = false;
    libBEDD5153_gv_countStrikes = 0;
    TriggerEnable(libBEDD5153_gt_Strike, false);
    libBEDD5153_gf_PlayAnimationonTopbarItems(1, "Birth", "Merc", 1, 4, 0.3, c_timeReal, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libBEDD5153_gt_ExitTargetingMode_Init () {
    libBEDD5153_gt_ExitTargetingMode = TriggerCreate("libBEDD5153_gt_ExitTargetingMode_Func");
    TriggerAddEventMouseClicked(libBEDD5153_gt_ExitTargetingMode, c_playerAny, c_mouseButtonRight, true);
}

